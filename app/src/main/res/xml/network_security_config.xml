<?xml version="1.0" encoding="utf-8"?>
<!-- 自建 Calibre 常见 http:// + 自签证书场景，统一放开；自签信任由应用内开关控制 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
